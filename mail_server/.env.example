# Copy to .env (git-ignored). site.yml reads this file itself.
#
# The password of svc-mail, the account the mail server looks users up with.
# The same value goes into ../samba_ad/.env as SAMBA_SVC_MAIL_PASSWORD, which
# creates the account (README.md, "Secrets").
MAIL_LDAP_PASSWORD=the-svc-mail-password
#
# Shared with the Cloudflare Email Worker: the receiver only takes mail that
# carries it. Hex, so it needs no quoting:  openssl rand -hex 32
MAIL_RECEIVER_SECRET=a-long-random-hex-string
#
# Roundcube's key for what it keeps encrypted in sessions; 24 characters:
#   openssl rand -hex 12
MAIL_ROUNDCUBE_DES_KEY=0123456789abcdef01234567
#
# The Cloudflare Tunnel's token. Empty until the tunnel exists; cloudflared
# stays off until it is set.
MAIL_CLOUDFLARED_TOKEN=
