# {{ ansible_managed }}
#
# Webmail for {{ mail_domain }}: librenfra mail_server/roles/webmail.

# Through the Cloudflare Tunnel: cloudflared forwards https://{{ mail_fqdn }}
# here. Cloudflare has done TLS, and names the visitor in CF-Connecting-IP.
server {
    listen 127.0.0.1:{{ webmail_tunnel_port }};
    server_name {{ mail_fqdn }};
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    include snippets/acme-challenge.conf;
    include snippets/roundcube.conf;
}

# From the LAN, directly - the firewall answers {{ mail_fqdn }} with this
# server's address inside. Plain HTTP only redirects.
server {
    listen 80 default_server;
    server_name _;
    include snippets/acme-challenge.conf;
    location / {
        return 301 https://{{ mail_fqdn }}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name {{ mail_fqdn }};
    ssl_certificate {{ mail_tls_cert_file }};
    ssl_certificate_key {{ mail_tls_key_file }};
    include snippets/roundcube.conf;
}
