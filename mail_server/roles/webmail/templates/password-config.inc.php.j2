<?php
// {{ ansible_managed }}
//
// Roundcube's password plugin: users change their Active Directory password
// themselves. It finds the user as {{ mail_ad_bind_user }}, binds as the
// user with the current password, and changes it over LDAPS - the way AD
// lets a user change their own (files/ldap_samba_ad_change.php; the packaged
// ldap_samba_ad driver resets, which only an administrator may).
// /etc/ldap/ldap.conf holds the DC's CA (roles/mail_base).
$config['password_driver'] = 'ldap_samba_ad_change';
$config['password_confirm_current'] = true;
// The domain's own policy (samba-tool domain passwordsettings show) decides
// the rest; the DC refuses what it does not allow.
$config['password_minimum_length'] = 8;
$config['password_ldap_host'] = 'ldaps://{{ mail_ad_server }}';
$config['password_ldap_port'] = '636';
$config['password_ldap_version'] = '3';
$config['password_ldap_basedn'] = '{{ mail_ad_base }}';
$config['password_ldap_method'] = 'user';
$config['password_ldap_userDN_mask'] = null;
$config['password_ldap_searchDN'] = '{{ mail_ad_bind_user }}';
$config['password_ldap_searchPW'] = '{{ mail_ldap_password }}';
$config['password_ldap_search_base'] = '{{ mail_ad_base }}';
$config['password_ldap_search_filter'] = '(&(objectClass=user)(mail=%login))';
