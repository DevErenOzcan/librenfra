# {{ ansible_managed }}
#
# The directory's web admin, LDAP Account Manager, on the DC itself.
# librenfra samba_ad/roles/ad_admin_ui.

# From the internet, through the Cloudflare Tunnel (../../cloudflare):
# cloudflared forwards https://{{ ad_admin_ui_public_host }} here. Cloudflare
# has done TLS, and names the visitor in CF-Connecting-IP.
server {
    listen 127.0.0.1:{{ ad_admin_ui_tunnel_port }};
    server_name {{ ad_admin_ui_public_host }};
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    # Redirect to a path, not to http://...:8081 - the visitor is on https.
    absolute_redirect off;
    include snippets/lam.conf;
}

# From inside the firewall, directly.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Samba's own certificate, issued to {{ samba_ad_fqdn }} by the CA Samba made
# with the domain: browsers that do not trust that CA warn once.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /var/lib/samba/private/tls/cert.pem;
    ssl_certificate_key /var/lib/samba/private/tls/key.pem;

{% for net in ad_admin_ui_allow %}
    allow {{ net }};
{% endfor %}
    deny all;

    include snippets/lam.conf;
}
