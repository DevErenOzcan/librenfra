# Copy to .env (git-ignored). Only the run that creates the domain needs it;
# site.yml reads this file itself. Samba wants upper case, lower case and a
# digit - this makes one (README.md, "The Administrator password"):
#   printf 'SAMBA_ADMIN_PASSWORD=Aa1-%s\n' "$(openssl rand -hex 16)" >> .env
SAMBA_ADMIN_PASSWORD=the-domain-administrator-password
#
# svc-mail, the account the mail server looks mailboxes up with
# (host_vars/dc1.yml, samba_ad_service_accounts). Only read when the account
# is created. The same value is MAIL_LDAP_PASSWORD in ../mail_server/.env:
#   printf 'Aa1-%s\n' "$(openssl rand -hex 20)"
SAMBA_SVC_MAIL_PASSWORD=the-svc-mail-password
#
# LDAP Account Manager's own settings password (roles/ad_admin_ui) - not an
# AD password: openssl rand -hex 16
SAMBA_LAM_PASSWORD=a-long-random-password
#
# The Cloudflare Tunnel's token (cloudflare/, output tunnel_token). Empty:
# cloudflared stays off and the admin page is only reachable inside.
SAMBA_CLOUDFLARED_TOKEN=
