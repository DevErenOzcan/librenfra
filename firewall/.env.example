# Copy to .env (git-ignored) and fill in the firewall's API key, from the file
# OPNsense downloads when the key is created (README.md, "The API key").
# site.yml reads this file itself; nothing has to be exported.
OPNSENSE_API_KEY=key-from-the-downloaded-file
OPNSENSE_API_SECRET=secret-from-the-downloaded-file
